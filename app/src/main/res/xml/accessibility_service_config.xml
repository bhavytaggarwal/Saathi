<?xml version="1.0" encoding="utf-8"?>
<!--
  Read-only by design: canPerformGestures is absent, so Android refuses gestures from this service.
  Keep packageNames in sync with core/Allowlist.kt. A unit test and the auditReadOnly build task
  check this. Messaging, email, banking and the notification shade must never be added.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeViewClicked|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_description"
    android:isAccessibilityTool="true"
    android:notificationTimeout="100"
    android:packageNames="com.google.android.apps.nbu.paisa.user,com.android.settings,com.google.android.youtube,com.android.vending,com.openai.chatgpt,com.google.android.apps.bard,com.google.android.apps.nexuslauncher,com.sec.android.app.launcher,com.miui.home,com.mi.android.globallauncher,com.android.launcher3,com.android.launcher,com.oppo.launcher,net.oneplus.launcher,com.bbk.launcher2,com.transsion.hilauncher,com.nothing.launcher" />
